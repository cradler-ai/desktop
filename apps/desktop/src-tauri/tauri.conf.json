{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cradler Desktop",
  "version": "0.1.3",
  "identifier": "ai.cradler.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cradler Desktop",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 580,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "fullScreenUI"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "Cradler",
    "homepage": "https://cradler.ai/desktop",
    "copyright": "© 2026 Cradler",
    "shortDescription": "Install, check and fix AI skills, MCP servers and plugins",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
